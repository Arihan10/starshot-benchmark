USE_ASSET_LIBRARY=true
DOWNGRADE_NOUN_PHRASE=false
FAL_KEY=...
OPENROUTER_API_KEY=sk-or-...
# LongCat (OpenAI-compatible) - direct https://api.longcat.chat/openai/v1 backend for the `longcat` model slot
LONGCAT_API_KEY=...
# SiliconFlow (OpenAI-compatible) - serves meituan-longcat/LongCat-2.0 for the `longcat-sf` model slot
SILICONFLOW_API_KEY=...
# Moonshot (OpenAI-compatible) - direct https://api.moonshot.ai/v1 backend for the `kimi-k3` model slot
MOONSHOT_API_KEY=...
# Rotating key pools for `rotate`-enabled OPENAI_COMPAT_MODELS: on HTTP 429 the
# active key rolls to the next one. JSON array or comma-separated; when unset,
# the single *_API_KEY above is used (one key = no rotation).
# LONGCAT_API_KEY_ARRAY=["ak_1...","ak_2...","ak_3..."]
# SILICONFLOW_API_KEY_ARRAY=sk-1...,sk-2...
# MOONSHOT_API_KEY_ARRAY=sk-1...,sk-2...
RUNWARE_API_KEY=...
GOOGLE_API_KEY=AI...
# Tencent Cloud - direct Hunyuan 3D 3.1 Rapid backend (regenerate)
TENCENTCLOUD_SECRET_ID=...
TENCENTCLOUD_SECRET_KEY=...
TENCENTCLOUD_REGION=ap-singapore
# Full-scene generate gate backend: trellis | hunyuan | hunyuan-tencent
GENERATE_SCENE_BACKEND=trellis

# Cloudflare prod publish (R2 + D1) - benchmark-prod token
CLOUDFLARE_ACCOUNT_ID=...
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET=benchmark-assets-prod
CLOUDFLARE_API_TOKEN=cfat_...
D1_DATABASE_ID=...
