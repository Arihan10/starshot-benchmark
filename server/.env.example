USE_ASSET_LIBRARY=true
FAL_KEY=...
OPENROUTER_API_KEY=sk-...
GOOGLE_API_KEY=AI...
# Tencent Cloud — for the "regenerate (hunyuan 3.1)" backend (direct Hunyuan 3D
# 3.1 Rapid API). Region defaults to ap-singapore (the intl host that serves it).
TENCENTCLOUD_SECRET_ID=...
TENCENTCLOUD_SECRET_KEY=...
TENCENTCLOUD_REGION=ap-singapore
# Mesh backend for the full-scene "generate" gate: trellis (default) | hunyuan |
# hunyuan-tencent. Set hunyuan-tencent to build whole scenes on Hunyuan 3D 3.1
# (paced one request at a time). Per-asset regenerate is chosen per-button instead.
GENERATE_SCENE_BACKEND=trellis