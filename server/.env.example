USE_ASSET_LIBRARY=true
FAL_KEY=...
OPENROUTER_API_KEY=sk-...
GOOGLE_API_KEY=AI...
# Tencent Cloud — for the "regenerate (hunyuan 3.1)" backend (direct Hunyuan 3D
# 3.1 Rapid API). Region defaults to ap-singapore (the intl host that serves it).
TENCENTCLOUD_SECRET_ID=...
TENCENTCLOUD_SECRET_KEY=...
TENCENTCLOUD_REGION=ap-singapore
# Mesh backend for the full-scene "generate" gate: trellis (default) | hunyuan |
# hunyuan-tencent. Set hunyuan-tencent to build whole scenes on Hunyuan 3D 3.1
# (paced one request at a time). Per-asset regenerate is chosen per-button instead.
GENERATE_SCENE_BACKEND=trellis

# --- Prod publish (POST /publish/{run}/{slot}/{model}) ----------------------
# Pushes a cell's preview + tour to the Cloudflare R2 bucket under per-version
# keys and records them in the D1 catalog. CLOUDFLARE_ACCOUNT_ID is shared by
# both (R2 endpoint host + D1 API path).
CLOUDFLARE_ACCOUNT_ID=...
# R2 API token (S3 credentials) with write access to the bucket.
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET=benchmark-assets-prod
# Cloudflare API token with D1 edit permission, and the target database id.
CLOUDFLARE_API_TOKEN=...
D1_DATABASE_ID=7437d4b3-a91c-4587-90cc-3a2ef269031d