# Asset mode is now chosen per cell from the client (the "assets:
# library ▸ generated" toggle), not globally. This flag only sets the
# DEFAULT mode for requests that don't name one: true -> library
# (LLM-matched prebuilt assets in objects/), false -> generated
# (from-scratch Nano-Banana + Trellis in objects-generated/).
USE_ASSET_LIBRARY=true
FAL_KEY=...
OPENROUTER_API_KEY=sk-...
GOOGLE_API_KEY=AI...